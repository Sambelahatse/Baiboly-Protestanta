{% extends 'base.html.twig' %}

{% block title %}{{ book.name }} {{ chapter.chapterNumber }}{% endblock %}

{% block extra_css %}
<style>
    /* Layout deux colonnes : sidebar chapitres + lecteur */
    .chapter-layout {
        display: flex;
        gap: 32px;
        align-items: flex-start;
    }

    /* Sidebar chapitres */
    .chapter-sidebar {
        width: 56px;
        flex-shrink: 0;
        position: sticky;
        top: 74px;
    }
    .chapter-sidebar-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
        max-height: calc(100vh - 120px);
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
    }
    .chap-pill {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 34px;
        border-radius: 6px;
        font-size: 12px;
        font-variant-numeric: tabular-nums;
        color: var(--fg-dim);
        text-decoration: none;
        transition: all .12s;
        border: 1px solid transparent;
    }
    .chap-pill:hover { color: var(--gold); border-color: var(--border); background: var(--surface); text-decoration: none; }
    .chap-pill.current { background: var(--gold); color: var(--bg); font-weight: 600; border-color: var(--gold); }

    /* Lecteur */
    .chapter-reader { flex: 1; min-width: 0; }

    .chapter-header { text-align: center; margin-bottom: 40px; }
    .chapter-eyebrow {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .16em;
        color: var(--fg-dim);
        margin-bottom: 10px;
    }
    .chapter-title {
        font-family: var(--font-display);
        font-size: clamp(30px, 6vw, 52px);
        font-weight: 600;
        margin: 0 0 8px;
        text-wrap: balance;
    }
    .chapter-subtitle {
        font-family: var(--font-display);
        font-size: 20px;
        font-style: italic;
        color: var(--gold);
        margin: 0;
    }

    .chapter-divider {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 0 0 36px;
        color: var(--fg-dim);
    }
    .chapter-divider::before, .chapter-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
    }
    .ornament { font-size: 10px; letter-spacing: 4px; color: var(--gold-dim); }

    /* Versets */
    .verses { font-family: var(--font-body); font-size: 17px; line-height: 1.9; }
    .verse {
        display: flex;
        gap: 12px;
        padding: 4px 8px;
        border-radius: 5px;
        margin-bottom: 2px;
        scroll-margin-top: 80px;
        cursor: pointer;
        transition: background .12s;
    }
    .verse:hover { background: rgba(201,168,76,.06); }
    .verse.highlighted { background: rgba(201,168,76,.14); }

    .verse-num {
        font-family: var(--font-ui);
        font-size: 11px;
        font-weight: 500;
        color: var(--gold);
        padding-top: 5px;
        min-width: 22px;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
        user-select: none;
    }
    .verse-text { flex: 1; min-width: 0; }

    /* Navigation bas de page */
    .chapter-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 56px;
        padding-top: 28px;
        border-top: 1px solid var(--border);
        gap: 12px;
    }
    .chapter-nav .btn .nav-label {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 160px;
    }

    /* Font-size control */
    .font-controls {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
        margin-bottom: 20px;
    }
    .font-btn {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--fg-muted);
        border-radius: 5px;
        padding: 4px 8px;
        cursor: pointer;
        font-family: var(--font-ui);
        font-size: 12px;
        transition: all .12s;
    }
    .font-btn:hover, .font-btn.active { color: var(--gold); border-color: var(--gold-dim); }

    @media (max-width: 600px) {
        .chapter-sidebar { display: none; }
        .chapter-layout { display: block; }
    }
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">

    <nav class="breadcrumb">
        <a href="{{ path('app_home') }}">Baiboly</a>
        <span class="breadcrumb-sep">/</span>
        <a href="{{ path('book_show', { bookNumber: book.bookNumber }) }}">{{ book.name }}</a>
        <span class="breadcrumb-sep">/</span>
        <strong>Toko {{ chapter.chapterNumber }}</strong>
    </nav>

    <div class="chapter-layout">

        {# Sidebar : liste des chapitres du livre #}
        <aside class="chapter-sidebar">
            <div class="chapter-sidebar-list">
                {% for chap in book.chapters %}
                <a href="{{ path('book_chapter', { bookNumber: book.bookNumber, chapterNumber: chap.chapterNumber }) }}"
                   class="chap-pill {{ chap.chapterNumber == chapter.chapterNumber ? 'current' : '' }}"
                   id="sidebar-chap-{{ chap.chapterNumber }}">
                    {{ chap.chapterNumber }}
                </a>
                {% endfor %}
            </div>
        </aside>

        {# Lecteur principal #}
        <div class="chapter-reader">

            <div class="font-controls">
                <button class="font-btn" onclick="setFont(15)" data-size="15">A−</button>
                <button class="font-btn active" onclick="setFont(17)" data-size="17">A</button>
                <button class="font-btn" onclick="setFont(19)" data-size="19">A+</button>
                <button class="font-btn" onclick="setFont(22)" data-size="22">A++</button>
            </div>

            <div class="chapter-header">
                <div class="chapter-eyebrow">{{ book.testament }}</div>
                <h1 class="chapter-title">{{ book.name }}</h1>
                <p class="chapter-subtitle">Toko {{ chapter.chapterNumber }}</p>
            </div>

            <div class="chapter-divider"><span class="ornament">✦ ✦ ✦</span></div>

            <div class="verses" id="verses">
                {% for verse in chapter.verses %}
                <div class="verse" id="v{{ verse.verseNumber }}" onclick="this.classList.toggle('highlighted')">
                    <span class="verse-num">{{ verse.verseNumber }}</span>
                    <span class="verse-text">{{ verse.text }}</span>
                </div>
                {% endfor %}
            </div>

            <nav class="chapter-nav">
                {# Précédent #}
                {% if prev %}
                    <a href="{{ path('book_chapter', { bookNumber: prev.book.bookNumber, chapterNumber: prev.chapterNumber }) }}" class="btn">
                        ← <span class="nav-label">{{ prev.book.name }} {{ prev.chapterNumber }}</span>
                    </a>
                {% elseif prev_book %}
                    {% set lastChap = prev_book.chapters.last() %}
                    <a href="{{ path('book_chapter', { bookNumber: prev_book.bookNumber, chapterNumber: lastChap.chapterNumber }) }}" class="btn">
                        ← <span class="nav-label">{{ prev_book.name }} {{ lastChap.chapterNumber }}</span>
                    </a>
                {% else %}
                    <span></span>
                {% endif %}

                {# Suivant #}
                {% if next %}
                    <a href="{{ path('book_chapter', { bookNumber: next.book.bookNumber, chapterNumber: next.chapterNumber }) }}" class="btn">
                        <span class="nav-label">{{ next.book.name }} {{ next.chapterNumber }}</span> →
                    </a>
                {% elseif next_book %}
                    <a href="{{ path('book_chapter', { bookNumber: next_book.bookNumber, chapterNumber: 1 }) }}" class="btn">
                        <span class="nav-label">{{ next_book.name }} 1</span> →
                    </a>
                {% else %}
                    <span></span>
                {% endif %}
            </nav>

        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
    // Taille de police
    const verses = document.getElementById('verses');
    function setFont(size) {
        verses.style.fontSize = size + 'px';
        document.querySelectorAll('.font-btn').forEach(b => {
            b.classList.toggle('active', +b.dataset.size === size);
        });
        try { localStorage.setItem('baiboly_fontsize', size); } catch(e) {}
    }
    // Restaurer
    try {
        const saved = localStorage.getItem('baiboly_fontsize');
        if (saved) setFont(+saved);
    } catch(e) {}

    // Scroll sidebar to current chapter
    const cur = document.getElementById('sidebar-chap-{{ chapter.chapterNumber }}');
    if (cur) cur.scrollIntoView({ block: 'center' });

    // Scroll to verse from hash
    if (location.hash) {
        const el = document.querySelector(location.hash);
        if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); el.classList.add('highlighted'); }
    }
</script>
{% endblock %}
