{% extends 'base.html.twig' %}

{% block title %}{{ book.name }}{% endblock %}

{% block extra_css %}
<style>
    .book-header { margin-bottom: 36px; }
    .book-title {
        font-family: var(--font-display);
        font-size: clamp(28px, 6vw, 48px);
        font-weight: 600;
        margin: 0 0 6px;
        text-wrap: balance;
    }
    .book-meta {
        font-size: 13px;
        color: var(--fg-muted);
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }
    .book-meta span { display: flex; align-items: center; gap: 5px; }

    .section-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .14em;
        color: var(--fg-dim);
        margin-bottom: 12px;
    }

    .chapter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
        gap: 6px;
        margin-bottom: 48px;
    }
    .chapter-link {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 48px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 7px;
        color: var(--fg-muted);
        font-family: var(--font-ui);
        font-size: 14px;
        font-variant-numeric: tabular-nums;
        text-decoration: none;
        transition: all .12s;
    }
    .chapter-link:hover {
        color: var(--gold);
        border-color: var(--gold-dim);
        background: var(--surface2);
        text-decoration: none;
    }

    .nav-siblings {
        display: flex;
        justify-content: space-between;
        padding-top: 32px;
        border-top: 1px solid var(--border);
        gap: 12px;
    }
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">

    <nav class="breadcrumb">
        <a href="{{ path('app_home') }}">Baiboly</a>
        <span class="breadcrumb-sep">/</span>
        <span>{{ book.testament }}</span>
        <span class="breadcrumb-sep">/</span>
        <strong>{{ book.name }}</strong>
    </nav>

    <div class="book-header">
        <h1 class="book-title">{{ book.name }}</h1>
        <div class="book-meta">
            <span>📖 {{ book.testament }}</span>
            <span>{{ book.chapterCount }} toko</span>
        </div>
    </div>

    <p class="section-label">Misafidiana toko</p>
    <div class="chapter-grid">
        {% for chapter in book.chapters %}
        <a href="{{ path('book_chapter', { bookNumber: book.bookNumber, chapterNumber: chapter.chapterNumber }) }}"
           class="chapter-link">
            {{ chapter.chapterNumber }}
        </a>
        {% endfor %}
    </div>

    <div class="nav-siblings">
        {% if book.bookNumber > 1 %}
            {% set prev = null %}
            {# Lien vers le livre précédent via le premier toko #}
            <a href="{{ path('book_show', { bookNumber: book.bookNumber - 1 }) }}" class="btn">
                ← Boky {{ book.bookNumber - 1 }}
            </a>
        {% else %}
            <span></span>
        {% endif %}

        {% if book.bookNumber < 66 %}
            <a href="{{ path('book_show', { bookNumber: book.bookNumber + 1 }) }}" class="btn">
                Boky {{ book.bookNumber + 1 }} →
            </a>
        {% else %}
            <span></span>
        {% endif %}
    </div>

</div>
{% endblock %}
