{% extends 'base.html.twig' %}

{% block title %}Fikarohana{% if query %} — {{ query }}{% endif %}{% endblock %}

{% block extra_css %}
<style>
    .search-header { margin-bottom: 32px; }
    .search-header h1 {
        font-family: var(--font-display);
        font-size: 32px;
        font-weight: 600;
        margin: 0 0 16px;
    }
    .search-form {
        display: flex;
        gap: 10px;
        max-width: 560px;
    }
    .search-input {
        flex: 1;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 10px 16px;
        color: var(--fg);
        font-family: var(--font-ui);
        font-size: 15px;
        outline: none;
        transition: border-color .15s;
    }
    .search-input:focus { border-color: var(--gold-dim); }
    .search-input::placeholder { color: var(--fg-dim); }

    .search-meta {
        font-size: 13px;
        color: var(--fg-muted);
        margin-bottom: 24px;
    }
    .search-meta strong { color: var(--gold); }

    .result-list { display: flex; flex-direction: column; gap: 8px; }

    .result-item {
        display: block;
        padding: 14px 18px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        text-decoration: none;
        transition: all .12s;
        border-left: 3px solid transparent;
    }
    .result-item:hover {
        border-left-color: var(--gold);
        background: var(--surface2);
        text-decoration: none;
    }
    .result-ref {
        font-family: var(--font-ui);
        font-size: 11px;
        font-weight: 500;
        color: var(--gold);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }
    .result-text {
        font-family: var(--font-body);
        font-size: 15px;
        color: var(--fg-muted);
        line-height: 1.6;
    }
    .result-text mark {
        background: rgba(201,168,76,.25);
        color: var(--fg);
        border-radius: 2px;
        padding: 0 2px;
    }

    .no-results {
        text-align: center;
        padding: 48px 0;
        color: var(--fg-dim);
    }
    .no-results p { font-family: var(--font-display); font-size: 20px; font-style: italic; }

    .more-hint {
        margin-top: 20px;
        padding: 12px 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 13px;
        color: var(--fg-muted);
        text-align: center;
    }
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">

    <nav class="breadcrumb">
        <a href="{{ path('app_home') }}">Baiboly</a>
        <span class="breadcrumb-sep">/</span>
        <strong>Fikarohana</strong>
    </nav>

    <div class="search-header">
        <h1>Fikarohana</h1>
        <form class="search-form" action="{{ path('search_index') }}" method="get">
            <input class="search-input" type="search" name="q"
                   value="{{ query }}"
                   placeholder="Soraty ny teny hikarohana…"
                   autofocus autocomplete="off">
            <button type="submit" class="btn btn-gold">Kàrohy</button>
        </form>
    </div>

    {% if query %}
        {% if results|length > 0 %}
            <div class="search-meta">
                Voahita <strong>{{ total }}</strong> andininy
                {% if total > limit %} — aseho {{ limit }} voalohany{% endif %}
                ho an'ny « <strong>{{ query }}</strong> »
            </div>

            <div class="result-list">
                {% for verse in results %}
                    {% set url = path('book_chapter', {
                        bookNumber: verse.chapter.book.bookNumber,
                        chapterNumber: verse.chapter.chapterNumber
                    }) ~ '#v' ~ verse.verseNumber %}
                    <a href="{{ url }}" class="result-item">
                        <div class="result-ref">{{ verse.reference }}</div>
                        <div class="result-text">
                            {{ verse.text|replace({(query): '<mark>' ~ query ~ '</mark>'})|raw }}
                        </div>
                    </a>
                {% endfor %}
            </div>

            {% if total > limit %}
            <div class="more-hint">
                Misy <strong>{{ total - limit }}</strong> hafa — hamarino ny teny hikarohana mba hahitana ny marina.
            </div>
            {% endif %}

        {% else %}
            <div class="no-results">
                <p>Tsy hita ny « {{ query }} »</p>
                <p style="font-size:14px;font-family:var(--font-ui)">Andramo ny teny hafa na ny fomba fanoratana hafa.</p>
            </div>
        {% endif %}
    {% endif %}

</div>
{% endblock %}
